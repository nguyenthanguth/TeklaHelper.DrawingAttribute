<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48: the Tekla Open API runs there, so the oracle tests compare with it; net10.0: a modern runtime -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TeklaHelper.DrawingAttribute\TeklaHelper.DrawingAttribute.csproj" />
  </ItemGroup>

  <!--
    Oracle tests: on net48, when Tekla Structures 2025 is installed, the tests reference its Tekla.Structures.dll and
    check that the filter files and the filter catalog match what Tekla.Structures.Filtering writes. The folder comes
    from the registry, or from -p:TeklaBinDirectory=...; without Tekla (e.g. on CI) these tests are not compiled.
  -->
  <PropertyGroup Condition="'$(TeklaBinDirectory)' == '' And '$(OS)' == 'Windows_NT'">
    <TeklaMainDirectory>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Trimble\Tekla Structures\2025.0\setup', 'MainDir', null, RegistryView.Registry64))</TeklaMainDirectory>
    <TeklaBinDirectory Condition="'$(TeklaMainDirectory)' != ''">$([System.IO.Path]::Combine($(TeklaMainDirectory), '2025.0', 'bin'))</TeklaBinDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48' And '$(TeklaBinDirectory)' != '' And Exists('$(TeklaBinDirectory)\Tekla.Structures.dll')">
    <DefineConstants>$(DefineConstants);TEKLA_ORACLE</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <TeklaOracle>true</TeklaOracle>
  </PropertyGroup>

  <ItemGroup Condition="'$(TeklaOracle)' == 'true'">
    <Reference Include="Tekla.Structures">
      <HintPath>$(TeklaBinDirectory)\Tekla.Structures.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TeklaBinDirectory</_Parameter1>
      <_Parameter2>$(TeklaBinDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
