<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8 (Tekla plug-ins and tools) and .NET 8 have the code pages built in: only netstandard2.0 needs
         System.Text.Encoding.CodePages, whose version can differ from the one Tekla ships (7.0 in Tekla 2025) -->
    <TargetFrameworks>net48;net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TeklaHelper.DrawingAttribute</RootNamespace>
    <AssemblyName>TeklaHelper.DrawingAttribute</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TeklaHelper.DrawingAttribute</PackageId>
    <Version>1.3.1</Version>
    <!-- Fails the pack when the public API breaks what the last release offered -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
    <Description>Typed model of Tekla Structures drawing and view attribute files (.vi, .gd, .md, .ad, .wd, .cud, their .more and filter files) and the files of the property dialogs of the drawing editor (.dim, .drtxt, marks, graphics, links, parts, welds, reinforcement, section and detail marks, ... 41 types). Every page, tab and control of the view and drawing properties dialogs as C# properties, complete default files, view creation tables and filters, written byte for byte like Tekla. Save the files and load them by name with GADrawing, View and the other Tekla Open API objects. No Tekla reference.</Description>
    <PackageTags>tekla;tekla-structures;tekla-open-api;open-api;drawing;attributes;view-properties;filter</PackageTags>
    <Authors>nguyenthanguth</Authors>
    <Copyright>Copyright (c) 2026 nguyenthanguth</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/nguyenthanguth/TeklaHelper.DrawingAttribute</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nguyenthanguth/TeklaHelper.DrawingAttribute.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Attribute files are written in the ANSI code page named on their "encoding" line (1252, 932, 949, ...) -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeklaHelper.DrawingAttribute.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
